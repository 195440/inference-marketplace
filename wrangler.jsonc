{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-14",
  "compatibility_flags": ["nodejs_compat_v2"],
  "workers_dev": true,
  // The Worker serves the static dashboard (web/out) AND the /v1/* API.
  // Requests matching a built asset are served directly; everything else runs
  // the Worker (so /v1/*, /health hit Hono).
  "assets": { "directory": "./web/out" },
  // Default deploy = TESTNET (inference.aibtc.com). Legion fee-rail intentionally
  // OMITTED: with no LEGION_* set, settle() uses the direct x402 "exact" scheme —
  // non-custodial, 100% to the provider, in the provider's chosen token
  // (sBTC/USDCx). Re-add the LEGION_* block to bring back the 8% skim.
  "vars": {
    "NETWORK": "testnet",
    "RELAY_URL": "https://x402-relay.aibtc.dev",
    "PRICE_MARKUP": "1.5",
    "STACKS_API": "https://api.testnet.hiro.so",
    "RECIPIENT_ADDRESS": "ST2VN1G6EBXPMMAJKCSY1HR50YQCVFSK68KKP9SKW"
  },
  // Create with: wrangler kv namespace create PROVIDERS  → paste the id below.
  // PROVIDERS (KV) now holds only ephemeral data: wallet-auth replay nonces and
  // the legion stake cache. The provider directory lives in D1 (DB) below.
  "kv_namespaces": [{ "binding": "PROVIDERS", "id": "b276cbda64074ccca34585c7837f7c49" }],
  // Provider directory (D1: inference-db, region APAC). Local `wrangler dev` uses a
  // local SQLite keyed by the binding; --remote / deploy use this database_id.
  "d1_databases": [{ "binding": "DB", "database_name": "inference-db", "database_id": "58bab586-33b9-4036-83e8-c22f76379e3e" }],
  // Continuous provider health monitoring.
  "triggers": { "crons": ["*/5 * * * *"] },
  "env": {
    "staging": {
      "name": "gateway-staging",
      "workers_dev": true,
      "assets": { "directory": "./web/out" },
      // Staging = TESTNET, fee-free (no LEGION_* → direct non-custodial settle).
      "vars": {
        "NETWORK": "testnet",
        "RELAY_URL": "https://x402-relay.aibtc.dev",
        "PRICE_MARKUP": "1.5",
        "STACKS_API": "https://api.testnet.hiro.so",
        "RECIPIENT_ADDRESS": "ST2VN1G6EBXPMMAJKCSY1HR50YQCVFSK68KKP9SKW"
      },
      "kv_namespaces": [{ "binding": "PROVIDERS", "id": "b276cbda64074ccca34585c7837f7c49" }],
      "d1_databases": [{ "binding": "DB", "database_name": "inference-db", "database_id": "58bab586-33b9-4036-83e8-c22f76379e3e" }],
      "triggers": { "crons": ["*/5 * * * *"] }
    },
    "production": {
      "name": "gateway",
      "workers_dev": false,
      "assets": { "directory": "./web/out" },
      // Production = MAINNET, fee-free. No LEGION_* → settle() uses the direct
      // x402 "exact" scheme: non-custodial, 100% to the provider, in the token
      // the provider chose (sBTC/USDCx; mainnet contracts in x402-middleware.ts).
      // RECIPIENT_ADDRESS (mainnet house payout, SP…/SM…) is a SECRET, set with:
      //   wrangler secret put RECIPIENT_ADDRESS --env production
      "vars": {
        "NETWORK": "mainnet",
        "RELAY_URL": "https://x402-relay.aibtc.com",
        "PRICE_MARKUP": "1.5",
        "STACKS_API": "https://api.hiro.so"
      },
      "kv_namespaces": [{ "binding": "PROVIDERS", "id": "b276cbda64074ccca34585c7837f7c49" }],
      // Fresh MAINNET D1 (created 2026-07-21) — keeps mainnet providers isolated
      // from the shared testnet directory (testnet ST… rows are unpayable on
      // mainnet). Schema applied via `wrangler d1 execute … --remote --file=schema.sql`.
      "d1_databases": [{ "binding": "DB", "database_name": "inference-db-mainnet", "database_id": "81a777bf-fd21-49f9-9b4c-241cc5eb3f83" }],
      "triggers": { "crons": ["*/5 * * * *"] }
    }
  }
}
